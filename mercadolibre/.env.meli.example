# Variables del canal de Mercado Libre. Van en el servicio NUEVO de Railway
# (o agrégalas al .env local para probar). Las de ANTHROPIC / WECALL /
# TWILIO se reutilizan tal como ya las tienes.

# --- App de Mercado Libre (developers.mercadolibre.com.ve → Mis aplicaciones)
MELI_APP_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=https://TU-SERVICIO.up.railway.app/meli/callback

# --- Seguridad del panel (/meli/panel). Inventa una clave larga.
MELI_PANEL_TOKEN=

# --- A quién avisar (tu WhatsApp, con código de país)
MELI_DUENO_WHATSAPP=+58414XXXXXXX
MELI_PANEL_URL=https://TU-SERVICIO.up.railway.app/meli/panel

# --- Cómo se comporta
# Recomendado los primeros días: "aprobar" (el bot redacta y tú publicas desde el panel).
# Cuando confíes en lo que responde: "auto".
MELI_MODO_PREGUNTAS=aprobar
MELI_MODO_POSTVENTA=aprobar          # auto | aprobar | apagado

# Datos que el bot le pasa al comprador para pagar (usa \n para saltos de línea)
MELI_DATOS_PAGO=Pago Móvil: Banco XXXX, C.I. V-00000000, 0414-0000000\nZelle: correo@ejemplo.com (Nombre Apellido)
MELI_OPCIONES_ENVIO=Envío por MRW, Zoom o Tealca (cobro a destino) o retiro personal en Caracas.
MELI_HORARIO=lunes a sábado de 8 a. m. a 6 p. m.
MELI_NEGOCIO=Ventas 24

# Modelo de Claude (el agente de WhatsApp usa claude-sonnet-4-6)
MELI_MODELO=claude-opus-5

# Base de datos propia de este canal (en Railway, dentro del volumen)
MELI_DB_PATH=/data/meli.db
