{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "startCommand": "gunicorn mercadolibre.app_meli:app --workers 1 --threads 8 --bind 0.0.0.0:$PORT",
    "healthcheckPath": "/meli/salud",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
